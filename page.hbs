{{> head}}
{{> navbar}}
<main class="main {{#unless @config.custom.showSidebar}}main--full{{/unless}}">
    {{#if @customHTML.beforePage}}
        <div class="custom-html custom-html--before-page">{{{@customHTML.beforePage}}}</div>
    {{/if}}

    {{#page}}
        <article class="page-entry">
            <header class="page-entry__header">
                <h1>{{title}}</h1>
            </header>

            {{#featuredImage}}
                {{#if url}}
                    <figure class="page-entry__featured">
                        <img src="{{url}}" alt="{{alt}}" width="{{width}}" height="{{height}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset sizes}}{{/if}} {{lazyload "eager"}}>
                        {{#checkIfAny caption credits}}<figcaption>{{caption}} {{credits}}</figcaption>{{/checkIfAny}}
                    </figure>
                {{/if}}
            {{/featuredImage}}

            <div class="entry-content">{{{text}}}</div>

            {{#if @config.page.displayAuthorBio}}
                {{#author}}
                    <section class="author-bio">
                        {{#if avatar}}<img src="{{avatarImage.url}}" alt="{{avatarImage.alt}}" width="{{avatarImage.width}}" height="{{avatarImage.height}}" {{lazyload "lazy"}}>{{/if}}
                        <div><h2><a href="{{url}}">{{name}}</a></h2>{{#if description}}<div>{{{description}}}</div>{{/if}}</div>
                    </section>
                {{/author}}
            {{/if}}

            {{#if @config.page.displayChildPages}}
                {{#if subpages}}
                    <nav class="child-pages"><h2>{{translate 'page.childPages'}}</h2><ul>{{> subpages-list}}</ul></nav>
                {{/if}}
            {{/if}}
        </article>
    {{/page}}

    {{{@commentsCustomCode}}}
    {{#if @customHTML.afterPage}}<div class="custom-html custom-html--after-page">{{{@customHTML.afterPage}}}</div>{{/if}}
</main>
{{#if @config.custom.showSidebar}}<aside class="sidebar">{{> sidebar}}</aside>{{/if}}
{{> footer}}

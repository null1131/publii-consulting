{{> head}}
{{> navbar}}
<main class="main {{#unless @config.custom.showSidebar}}main--full{{/unless}}">
    <header class="listing-header">
        <span class="eyebrow">{{@website.name}}</span>
        <h1>Insights &amp; updates</h1>
    </header>
    <div class="post-grid">
        {{#each posts}}
            <article class="post-card">
                {{#featuredImage}}
                    {{#if url}}
                        <a class="post-card__image" href="{{../url}}">
                            <img src="{{url}}" alt="{{alt}}" width="{{width}}" height="{{height}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset sizes}}{{/if}} {{lazyload "lazy"}}>
                        </a>
                    {{/if}}
                {{/featuredImage}}
                <div class="post-card__body">
                    <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time>
                    <h2><a href="{{url}}">{{title}}</a></h2>
                    {{#if hasCustomExcerpt}}{{{excerpt}}}{{else}}<p>{{{excerpt}}}</p>{{/if}}
                    <a class="text-link" href="{{url}}">Read more <span aria-hidden="true">&rarr;</span></a>
                </div>
            </article>
        {{/each}}
    </div>
    {{> pagination}}
</main>
{{#if @config.custom.showSidebar}}<aside class="sidebar">{{> sidebar}}</aside>{{/if}}
{{> footer}}

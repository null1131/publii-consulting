{{> head}}
{{> navbar}}
<main class="main {{#unless @config.custom.showSidebar}}main--full{{/unless}}">
    {{#if @customHTML.beforePost}}<div class="custom-html custom-html--before-post">{{{@customHTML.beforePost}}}</div>{{/if}}
    {{#post}}
        <article class="post-entry">
            <header class="post-entry__header">
                <h1>{{title}}</h1>
                {{#checkIfAny @config.post.displayAuthor @config.post.displayDate mainTag}}
                    <div class="post-entry__meta">
                        {{#if @config.post.displayDate}}<time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">{{date createdAt}}</time>{{/if}}
                        {{#if @config.post.displayAuthor}}{{#author}}<a href="{{url}}" rel="author">{{name}}</a>{{/author}}{{/if}}
                        {{#if mainTag}}<a href="{{mainTag.url}}">{{mainTag.name}}</a>{{/if}}
                    </div>
                {{/checkIfAny}}
            </header>
            {{#featuredImage}}
                {{#if url}}
                    <figure class="post-entry__featured">
                        <img src="{{url}}" alt="{{alt}}" width="{{width}}" height="{{height}}" {{#if @config.site.responsiveImages}}{{responsiveImageAttributes 'featuredImage' srcset sizes}}{{/if}} {{lazyload "eager"}}>
                        {{#checkIfAny caption credits}}<figcaption>{{caption}} {{credits}}</figcaption>{{/checkIfAny}}
                    </figure>
                {{/if}}
            {{/featuredImage}}
            <div class="entry-content">{{{text}}}</div>
            {{#if @config.post.displayAuthorBio}}
                {{#author}}<section class="author-bio">{{#if avatar}}<img src="{{avatarImage.url}}" alt="{{avatarImage.alt}}" width="{{avatarImage.width}}" height="{{avatarImage.height}}" {{lazyload "lazy"}}>{{/if}}<div><h2><a href="{{url}}">{{name}}</a></h2>{{#if description}}<div>{{{description}}}</div>{{/if}}</div></section>{{/author}}
            {{/if}}
        </article>
        {{#checkIfAny ../previousPost ../nextPost}}<nav class="post-navigation">{{#../previousPost}}<a href="{{url}}" rel="prev">&larr; {{title}}</a>{{/../previousPost}}{{#../nextPost}}<a href="{{url}}" rel="next">{{title}} &rarr;</a>{{/../nextPost}}</nav>{{/checkIfAny}}
        {{#if ../relatedPosts}}<section class="related-posts"><h2>{{translate 'post.relatedPosts'}}</h2><div class="post-grid">{{#each ../relatedPosts}}<article class="post-card"><div class="post-card__body"><h3><a href="{{url}}">{{title}}</a></h3><p>{{{excerpt}}}</p></div></article>{{/each}}</div></section>{{/if}}
    {{/post}}
    {{{@commentsCustomCode}}}
    {{#if @customHTML.afterPost}}<div class="custom-html custom-html--after-post">{{{@customHTML.afterPost}}}</div>{{/if}}
</main>
{{#if @config.custom.showSidebar}}<aside class="sidebar">{{> sidebar}}</aside>{{/if}}
{{> footer}}
